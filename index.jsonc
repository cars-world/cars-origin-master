{
  "name": "@cars-world/cars-origin-master",
  "summary": "Master of the origin side of the cars example app, where catalogs are captured originally; so far an HTTP server with GET / and GET /api/hello (its greeting with the version) and GET /health; runs as a container in the stages dev, test and prod.",
  "domain": [
    "master of the origin side: later holds all data of the side, on @rljson/server",
    "container cars-origin-master, Node, uid 1000, port 3000",
  ],
  "interfaces": {
    "uses": {
      "cars-deployment": "the reusable workflow build: deploys the image of origin-master to dev on a push to main"
    },
    "usedBy": {
      "cars-origin-client": "GET /api/hello over HTTP",
    },
  },
}
